pkg_fact("vtk",namespace("builtin")).
pkg_fact("vtk",version_deprecation_penalty(10)).
pkg_fact("vtk",version_declared("9.5.1",0)).
pkg_fact("vtk",version_origin("9.5.1","package_py")).
pkg_fact("vtk",version_declared("9.5.0",1)).
pkg_fact("vtk",version_origin("9.5.0","package_py")).
pkg_fact("vtk",version_declared("9.4.1",2)).
pkg_fact("vtk",version_origin("9.4.1","package_py")).
pkg_fact("vtk",version_declared("9.3.1",3)).
pkg_fact("vtk",version_origin("9.3.1","package_py")).
pkg_fact("vtk",version_declared("9.2.6",4)).
pkg_fact("vtk",version_origin("9.2.6","package_py")).
pkg_fact("vtk",version_declared("9.2.2",5)).
pkg_fact("vtk",version_origin("9.2.2","package_py")).
pkg_fact("vtk",version_declared("9.1.0",6)).
pkg_fact("vtk",version_origin("9.1.0","package_py")).
pkg_fact("vtk",version_declared("9.0.3",7)).
pkg_fact("vtk",version_origin("9.0.3","package_py")).
pkg_fact("vtk",version_declared("9.0.1",8)).
pkg_fact("vtk",version_origin("9.0.1","package_py")).
pkg_fact("vtk",version_declared("9.0.0",9)).
pkg_fact("vtk",version_origin("9.0.0","package_py")).
pkg_fact("vtk",deprecated_version("8.2.0")).
pkg_fact("vtk",deprecated_version("8.2.1a")).

