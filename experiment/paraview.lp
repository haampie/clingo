pkg_fact("utf8cpp",variant_condition("build_type",63805,63806)).
variant_type(63805,"single").
pkg_fact("utf8cpp",variant_default_value_from_package_py(63805,"Release")).
pkg_fact("utf8cpp",variant_penalty(63805,"Release",1)).
pkg_fact("utf8cpp",variant_penalty(63805,"Debug",2)).
pkg_fact("utf8cpp",variant_penalty(63805,"RelWithDebInfo",3)).
