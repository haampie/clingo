pkg_fact("ucc",namespace("builtin")).
pkg_fact("ucc",version_deprecation_penalty(7)).
pkg_fact("ucc",version_declared("1.7.0",0)).
pkg_fact("ucc",version_origin("1.7.0","package_py")).
pkg_fact("ucc",version_declared("1.6.0",1)).
pkg_fact("ucc",version_origin("1.6.0","package_py")).
pkg_fact("ucc",version_declared("1.5.1",2)).
pkg_fact("ucc",version_origin("1.5.1","package_py")).
pkg_fact("ucc",version_declared("1.5.0",3)).
pkg_fact("ucc",version_origin("1.5.0","package_py")).
pkg_fact("ucc",version_declared("1.4.4",4)).
pkg_fact("ucc",version_origin("1.4.4","package_py")).
pkg_fact("ucc",version_declared("1.3.0",5)).
pkg_fact("ucc",version_origin("1.3.0","package_py")).
pkg_fact("ucc",version_declared("1.2.0",6)).
pkg_fact("ucc",version_origin("1.2.0","package_py")).

% Variant amdgpu_target in package ucc
pkg_fact("ucc",condition(61851)).
condition_reason(61851,"Package ucc has variant 'amdgpu_target' when +rocm").
pkg_fact("ucc",condition_trigger(61851,61852)).
pkg_fact("ucc",variant_condition("amdgpu_target",61850,61851)).
variant_type(61850,"multi").
pkg_fact("ucc",variant_sticky(61850)).
pkg_fact("ucc",variant_default_value_from_package_py(61850,"none")).
pkg_fact("ucc",variant_value_from_disjoint_sets(61850,"none",0)).
pkg_fact("ucc",variant_value_from_disjoint_sets(61850,"gfx701",1)).
pkg_fact("ucc",variant_value_from_disjoint_sets(61850,"gfx801",1)).
pkg_fact("ucc",variant_value_from_disjoint_sets(61850,"gfx802",1)).
pkg_fact("ucc",variant_value_from_disjoint_sets(61850,"gfx803",1)).
pkg_fact("ucc",variant_value_from_disjoint_sets(61850,"gfx900",1)).
pkg_fact("ucc",variant_value_from_disjoint_sets(61850,"gfx900:xnack-",1)).
pkg_fact("ucc",variant_value_from_disjoint_sets(61850,"gfx902",1)).
