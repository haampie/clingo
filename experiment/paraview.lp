% Variant build_system in package fujitsu-mpi
pkg_fact("fujitsu-mpi",variant_definition("build_system",8647)).
variant_type(8647,"single").
pkg_fact("fujitsu-mpi",variant_default_value_from_package_py(8647,"generic")).
