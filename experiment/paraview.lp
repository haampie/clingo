condition_reason(66584,"Package zfp has variant 'tight-error' when @1.0.0:").
pkg_fact("zfp",condition_trigger(66584,66560)).
pkg_fact("zfp",variant_condition("tight-error",66583,66584)).
variant_type(66583,"bool").
pkg_fact("zfp",variant_default_value_from_package_py(66583,"False")).
pkg_fact("zfp",variant_penalty(66583,"False",1)).
pkg_fact("zfp",variant_penalty(66583,"True",2)).

% Variant twoway in package zfp
pkg_fact("zfp",variant_definition("twoway",66585)).
variant_type(66585,"bool").
pkg_fact("zfp",variant_default_value_from_package_py(66585,"False")).
pkg_fact("zfp",variant_penalty(66585,"False",1)).
pkg_fact("zfp",variant_penalty(66585,"True",2)).

% Variant utilities in package zfp
pkg_fact("zfp",variant_definition("utilities",66586)).
variant_type(66586,"bool").
pkg_fact("zfp",variant_default_value_from_package_py(66586,"True")).
pkg_fact("zfp",variant_penalty(66586,"True",1)).
pkg_fact("zfp",variant_penalty(66586,"False",2)).

