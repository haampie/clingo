% Package rules: utf8cpp
%----------------------------------------------------------------------------
pkg_fact("utf8cpp",namespace("builtin")).
pkg_fact("utf8cpp",version_deprecation_penalty(3)).
pkg_fact("utf8cpp",version_declared("4.0.6",0)).
