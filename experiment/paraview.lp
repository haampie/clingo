%----------------------------------------------------------------------------
% Package rules: unzip
%----------------------------------------------------------------------------
pkg_fact("unzip",namespace("builtin")).
pkg_fact("unzip",version_deprecation_penalty(1)).
pkg_fact("unzip",version_declared("6.0",0)).
pkg_fact("unzip",version_origin("6.0","package_py")).

% Variant build_system in package unzip
pkg_fact("unzip",variant_definition("build_system",63794)).
variant_type(63794,"single").
pkg_fact("unzip",variant_default_value_from_package_py(63794,"makefile")).
pkg_fact("unzip",variant_penalty(63794,"makefile",1)).

pkg_fact("unzip",condition(63795)).
condition_reason(63795,"conflict constraint build_system=makefile").
pkg_fact("unzip",condition_trigger(63795,63796)).
pkg_fact("unzip",condition(63797)).
condition_reason(63797,"conflict is triggered when platform=windows").
pkg_fact("unzip",condition_trigger(63797,63798)).
pkg_fact("unzip",conflict(63797,63795,"unzip: 'platform=windows' conflicts with 'build_system=makefile'")).

pkg_fact("unzip",condition(63799)).
condition_reason(63799,"unzip depends on gmake when build_system=makefile").
pkg_fact("unzip",condition_trigger(63799,63796)).
pkg_fact("unzip",condition_effect(63799,63800)).

pkg_fact("unzip",condition(63801)).
condition_reason(63801,"unzip depends on c").
pkg_fact("unzip",condition_trigger(63801,63802)).
pkg_fact("unzip",condition_effect(63801,63803)).


