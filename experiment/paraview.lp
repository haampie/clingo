attr("virtual_node",node(RuntimeID, "libgfortran")) :-
  attr("depends_on", node(ID, Package), ProviderNode, "link"),
  provider(ProviderNode, node(RuntimeID, "libgfortran")),
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("node_version_satisfies",node(IDgcc, "gcc"),"=11.5.0"),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"fortran").

attr("node_version_satisfies",node(RuntimeID, "libgfortran"),"5") :-
  attr("depends_on", node(ID, Package), ProviderNode, "link"),
  provider(ProviderNode, node(RuntimeID, "libgfortran")),
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("node_version_satisfies",node(IDgcc, "gcc"),"=11.5.0"),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"fortran").

propagate(node(ID, Package), node_version_satisfies("gcc", ":11.5.0")) :-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("node_version_satisfies",node(IDgcc, "gcc"),"=11.5.0").

