propagate(node(ID, Package), node_version_satisfies("gcc", ":13.3.0")) :-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("node_version_satisfies",node(IDgcc, "gcc"),"=13.3.0").

% Add compiler wrapper when using gcc for c
1 { attr("depends_on", node(ID, Package), node(0..X-1, "compiler-wrapper"), "build") : max_dupes("compiler-wrapper", X)} 1:-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"c").

% Add compiler wrapper when using gcc for cxx
1 { attr("depends_on", node(ID, Package), node(0..X-1, "compiler-wrapper"), "build") : max_dupes("compiler-wrapper", X)} 1:-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"cxx").

% Add compiler wrapper when using gcc for fortran
1 { attr("depends_on", node(ID, Package), node(0..X-1, "compiler-wrapper"), "build") : max_dupes("compiler-wrapper", X)} 1:-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"fortran").

% Add libc when using gcc
attr("dependency_holds", node(ID, Package), "libc", "link") :-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")).

attr("virtual_node",node(RuntimeID, "libc")) :-
  attr("depends_on", node(ID, Package), ProviderNode, "link"),
  provider(ProviderNode, node(RuntimeID, "libc")),
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")).

% Libc is glibc@=2.39 when using gcc@13.3.0/fhypd6ul4midmtovokp7kxc7bel6smrf
1 { attr("depends_on", node(ID, Package), node(0..X-1, "glibc"), "link") : max_dupes("glibc", X)} 1:-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("hash",node(IDgcc, "gcc"),"fhypd6ul4midmtovokp7kxc7bel6smrf").

attr("node_version_satisfies",node(RuntimeID, "glibc"),"=2.39") :-
  attr("depends_on", node(ID, Package), node(RuntimeID, "glibc"), "link"),
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("hash",node(IDgcc, "gcc"),"fhypd6ul4midmtovokp7kxc7bel6smrf").


