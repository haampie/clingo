provider_weight_from_config("glu","mesa-glu",0).
provider_weight_from_config("glu","openglu",1).



%----------------------------------------------------------------------------
% Virtual: iconv
%----------------------------------------------------------------------------
virtual("iconv").
provider_weight_from_config("iconv","libiconv",0).

requirement_group("iconv",0).
requirement_policy("iconv",0,"any_of").

pkg_fact("iconv",condition(9)).
condition_reason(9,"libiconv is a requirement for package iconv").
pkg_fact("iconv",condition_trigger(9,10)).
pkg_fact("iconv",condition_effect(9,11)).
requirement_group_member(9,"iconv",0).
requirement_has_weight(9,0).

pkg_fact("iconv",condition(12)).
condition_reason(12," is a requirement for package iconv").
pkg_fact("iconv",condition_trigger(12,13)).
pkg_fact("iconv",condition_effect(12,14)).
requirement_group_member(12,"iconv",0).
requirement_has_weight(12,1).


%----------------------------------------------------------------------------
% Trigger conditions
%----------------------------------------------------------------------------
pkg_fact("iconv",trigger_id(10)).
pkg_fact("iconv",trigger_msg("iconv ^iconv=libiconv")).
condition_requirement(10,"virtual_node","iconv").
condition_requirement(10,"node","libiconv").
condition_requirement(10,"virtual_on_incoming_edges","libiconv","iconv").

pkg_fact("iconv",trigger_id(13)).
pkg_fact("iconv",trigger_msg("iconv")).
condition_requirement(13,"virtual_node","iconv").


%----------------------------------------------------------------------------
% Imposed requirements
%----------------------------------------------------------------------------
pkg_fact("iconv",effect_id(14)).
pkg_fact("iconv",effect_msg("iconv")).
imposed_constraint(14,"virtual_node","iconv").

pkg_fact("libiconv",effect_id(11)).
pkg_fact("libiconv",effect_msg("libiconv")).
imposed_constraint(11,"node","libiconv").



