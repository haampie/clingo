%============================================================================
% General Constraints
%============================================================================

%----------------------------------------------------------------------------
% Compatible OS from concretizer config file
%----------------------------------------------------------------------------

%----------------------------------------------------------------------------
% Default platform
%----------------------------------------------------------------------------
node_platform_default("linux").
allowed_platform("linux").

%----------------------------------------------------------------------------
% Possible operating systems
%----------------------------------------------------------------------------
buildable_os("ubuntu24.04").
os("ubuntu24.04",0).

%----------------------------------------------------------------------------
% Target compatibility
%----------------------------------------------------------------------------
target_supported("gcc","11.5.0","zen2").
target_supported("gcc","11.5.0","zen").
target_supported("gcc","11.5.0","x86_64_v3").
target_supported("gcc","11.5.0","x86_64_v2").
target_supported("gcc","11.5.0","x86_64").
target_supported("gcc","11.5.0","x86_64").

target_supported("gcc","12.4.0","zen2").
target_supported("gcc","12.4.0","zen").
target_supported("gcc","12.4.0","x86_64_v3").
target_supported("gcc","12.4.0","x86_64_v2").
target_supported("gcc","12.4.0","x86_64").
target_supported("gcc","12.4.0","x86_64").

target_supported("gcc","13.3.0","zen2").
target_supported("gcc","13.3.0","zen").
target_supported("gcc","13.3.0","x86_64_v3").
target_supported("gcc","13.3.0","x86_64_v2").
target_supported("gcc","13.3.0","x86_64").
target_supported("gcc","13.3.0","x86_64").

target("zen2").
target_family("zen2","x86_64").
target_compatible("zen2","zen2").
target_compatible("zen2","zen").
target_compatible("zen2","x86_64_v3").
target_compatible("zen2","x86_64_v2").
target_compatible("zen2","x86_64").

target("zen").
target_family("zen","x86_64").
target_compatible("zen","zen").
target_compatible("zen","x86_64_v3").
target_compatible("zen","x86_64_v2").
target_compatible("zen","x86_64").

target("x86_64_v3").
target_family("x86_64_v3","x86_64").
target_compatible("x86_64_v3","x86_64_v3").
target_compatible("x86_64_v3","x86_64_v2").
target_compatible("x86_64_v3","x86_64").

target("x86_64_v2").
target_family("x86_64_v2","x86_64").
target_compatible("x86_64_v2","x86_64_v2").
target_compatible("x86_64_v2","x86_64").

target("x86_64").
target_family("x86_64","x86_64").
target_compatible("x86_64","x86_64").

target_weight("zen2",0).
target_weight("zen",1).
target_weight("x86_64_v3",2).
target_weight("x86_64_v2",3).
target_weight("x86_64",4).

