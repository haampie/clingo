pkg_fact("psm",namespace("builtin")).
pkg_fact("psm",version_deprecation_penalty(2)).
pkg_fact("psm",version_declared("3.3",0)).
pkg_fact("psm",version_origin("3.3","package_py")).
pkg_fact("psm",version_declared("2017-04-28",1)).
pkg_fact("psm",version_origin("2017-04-28","package_py")).

% Variant build_system in package psm
pkg_fact("psm",variant_definition("build_system",42006)).
variant_type(42006,"single").
pkg_fact("psm",variant_default_value_from_package_py(42006,"makefile")).
pkg_fact("psm",variant_penalty(42006,"makefile",1)).

pkg_fact("psm",condition(42007)).
condition_reason(42007,"conflict constraint build_system=makefile").
pkg_fact("psm",condition_trigger(42007,42008)).
pkg_fact("psm",condition(42009)).
condition_reason(42009,"conflict is triggered when platform=windows").
pkg_fact("psm",condition_trigger(42009,42010)).
pkg_fact("psm",conflict(42009,42007,"psm: 'platform=windows' conflicts with 'build_system=makefile'")).

pkg_fact("psm",condition(42011)).
condition_reason(42011,"conflict constraint @3.3").
pkg_fact("psm",condition_trigger(42011,42012)).
pkg_fact("psm",condition(42013)).
condition_reason(42013,"conflict is triggered when %gcc@6:").
pkg_fact("psm",condition_trigger(42013,42014)).
pkg_fact("psm",conflict(42013,42011,"psm: '%gcc@6:' conflicts with '@3.3'")).

pkg_fact("psm",condition(42015)).
condition_reason(42015,"psm depends on gmake when build_system=makefile").
pkg_fact("psm",condition_trigger(42015,42008)).
pkg_fact("psm",condition_effect(42015,42016)).

pkg_fact("psm",condition(42017)).
condition_reason(42017,"psm depends on c").
pkg_fact("psm",condition_trigger(42017,42018)).
pkg_fact("psm",condition_effect(42017,42019)).

pkg_fact("psm",condition(42020)).
condition_reason(42020,"psm depends on uuid").
pkg_fact("psm",condition_trigger(42020,42018)).
pkg_fact("psm",condition_effect(42020,42021)).


