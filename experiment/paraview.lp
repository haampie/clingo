pkg_fact("utf8cpp",version_origin("3.2.4","package_py")).
pkg_fact("utf8cpp",version_declared("2.3.4",2)).
pkg_fact("utf8cpp",version_origin("2.3.4","package_py")).

% Variant build_system in package utf8cpp
pkg_fact("utf8cpp",variant_definition("build_system",63804)).
variant_type(63804,"single").
pkg_fact("utf8cpp",variant_default_value_from_package_py(63804,"cmake")).
pkg_fact("utf8cpp",variant_penalty(63804,"cmake",1)).

% Variant build_type in package utf8cpp
pkg_fact("utf8cpp",condition(63806)).
condition_reason(63806,"Package utf8cpp has variant 'build_type' when build_system=cmake").
