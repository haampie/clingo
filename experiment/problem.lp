% Inject gcc-runtime when gcc is used as a c compiler
1 { attr("depends_on", node(ID, Package), node(0..X-1, "gcc-runtime"), "link") : max_dupes("gcc-runtime", X)} 1:-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("node_version_satisfies",node(IDgcc, "gcc"),"=14.2.0"),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"c").

attr("node_version_satisfies",node(RuntimeID, "gcc-runtime"),"14.2.0:") :-
  attr("depends_on", node(ID, Package), node(RuntimeID, "gcc-runtime"), "link"),
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("node_version_satisfies",node(IDgcc, "gcc"),"=14.2.0"),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"c").

