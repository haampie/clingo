pkg_fact("apple-clang",effect_msg("apple-clang")).
imposed_constraint(5,"node","apple-clang").

pkg_fact("c",effect_id(8)).
pkg_fact("c",effect_msg("c")).
imposed_constraint(8,"virtual_node","c").



