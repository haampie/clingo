provider_weight_from_config("c","apple-clang",0).
provider_weight_from_config("c","llvm",1).
provider_weight_from_config("c","gcc",2).
provider_weight_from_config("c","intel-oneapi-compilers",3).

requirement_group("c",0).
requirement_policy("c",0,"any_of").

pkg_fact("c",condition(3)).
condition_reason(3,"apple-clang is a requirement for package c").
pkg_fact("c",condition_trigger(3,4)).
pkg_fact("c",condition_effect(3,5)).
requirement_group_member(3,"c",0).
requirement_has_weight(3,0).

pkg_fact("c",condition(6)).
condition_reason(6," is a requirement for package c").
pkg_fact("c",condition_trigger(6,7)).
pkg_fact("c",condition_effect(6,8)).
requirement_group_member(6,"c",0).
requirement_has_weight(6,1).


%----------------------------------------------------------------------------
% Trigger conditions
%----------------------------------------------------------------------------
pkg_fact("c",trigger_id(4)).
pkg_fact("c",trigger_msg("c ^c=apple-clang")).
condition_requirement(4,"virtual_node","c").
condition_requirement(4,"node","apple-clang").
condition_requirement(4,"virtual_on_incoming_edges","apple-clang","c").

pkg_fact("c",trigger_id(7)).
pkg_fact("c",trigger_msg("c")).
condition_requirement(7,"virtual_node","c").


