condition_reason(5883,"Package hipcc has variant 'generator' when build_system=cmake").
pkg_fact("hipcc",condition_trigger(5883,5881)).
pkg_fact("hipcc",variant_condition("generator",5882,5883)).
variant_type(5882,"single").
pkg_fact("hipcc",variant_default_value_from_package_py(5882,"make")).
pkg_fact("hipcc",variant_possible_value(5882,"make")).
pkg_fact("hipcc",variant_penalty(5882,"make",1)).

