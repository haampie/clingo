pkg_fact("randrproto",version_origin("1.5.0","package_py")).

% Variant build_system in package randrproto
pkg_fact("randrproto",variant_definition("build_system",23571)).
variant_type(23571,"single").
pkg_fact("randrproto",variant_default_value_from_package_py(23571,"autotools")).
pkg_fact("randrproto",variant_penalty(23571,"autotools",1)).

