% Package rules: compositeproto
%----------------------------------------------------------------------------
pkg_fact("compositeproto",namespace("builtin")).
pkg_fact("compositeproto",version_deprecation_penalty(1)).
pkg_fact("compositeproto",version_declared("0.4.2",0)).
pkg_fact("compositeproto",version_origin("0.4.2","package_py")).

% Variant build_system in package compositeproto
pkg_fact("compositeproto",variant_definition("build_system",1895)).
variant_type(1895,"single").
pkg_fact("compositeproto",variant_default_value_from_package_py(1895,"autotools")).
pkg_fact("compositeproto",variant_penalty(1895,"autotools",1)).

pkg_fact("compositeproto",condition(1896)).
condition_reason(1896,"conflict constraint build_system=autotools").
pkg_fact("compositeproto",condition_trigger(1896,1897)).
pkg_fact("compositeproto",condition(1898)).
condition_reason(1898,"conflict is triggered when platform=windows").
pkg_fact("compositeproto",condition_trigger(1898,1899)).
pkg_fact("compositeproto",conflict(1898,1896,"compositeproto: 'platform=windows' conflicts with 'build_system=autotools'")).

