% Add a dependency on 'libgfortran@5' for nodes compiled with gcc@14.2.0/qvbchhox6bds55i7uboooc2jdvxbh6op and using the 'fortran' language
attr("dependency_holds", node(ID, Package), "fortran-rt", "link") :-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("node_version_satisfies",node(IDgcc, "gcc"),"=14.2.0"),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"fortran").

attr("virtual_node",node(RuntimeID, "fortran-rt")) :-
  attr("depends_on", node(ID, Package), ProviderNode, "link"),
  provider(ProviderNode, node(RuntimeID, "fortran-rt")),
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("node_version_satisfies",node(IDgcc, "gcc"),"=14.2.0"),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"fortran").

