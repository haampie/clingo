  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("node_version_satisfies",node(IDgcc, "gcc"),"=14.2.0"),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"fortran").

propagate(node(ID, Package), node_version_satisfies("gcc", ":14.2.0")) :-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("node_version_satisfies",node(IDgcc, "gcc"),"=14.2.0").

% Add compiler wrapper when using gcc for c
1 { attr("depends_on", node(ID, Package), node(0..X-1, "compiler-wrapper"), "build") : max_dupes("compiler-wrapper", X)} 1:-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"c").

% Add compiler wrapper when using gcc for cxx
1 { attr("depends_on", node(ID, Package), node(0..X-1, "compiler-wrapper"), "build") : max_dupes("compiler-wrapper", X)} 1:-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"cxx").

% Add compiler wrapper when using gcc for fortran
1 { attr("depends_on", node(ID, Package), node(0..X-1, "compiler-wrapper"), "build") : max_dupes("compiler-wrapper", X)} 1:-
  attr("node",node(ID, Package)),
  attr("depends_on",node(ID, Package),node(IDgcc, "gcc"),"build"),
  attr("node",node(IDgcc, "gcc")),
  attr("virtual_on_edge",node(ID, Package),node(IDgcc, "gcc"),"fortran").


%----------------------------------------------------------------------------
% Runtimes: requirements
%----------------------------------------------------------------------------
pkg_fact("gcc-runtime",condition(0)).
condition_reason(0,"gcc-runtime %[deptypes=build] gcc@=14.2.0 requires gcc-runtime@=14.2.0 at runtime").
pkg_fact("gcc-runtime",condition_trigger(0,1)).
pkg_fact("gcc-runtime",condition_effect(0,2)).

%----------------------------------------------------------------------------
% Trigger conditions
%----------------------------------------------------------------------------
pkg_fact("gcc-runtime",trigger_id(1)).
pkg_fact("gcc-runtime",trigger_msg("gcc-runtime %[deptypes=build] gcc@=14.2.0")).
condition_requirement(1,"node","gcc-runtime").
condition_requirement(1,"depends_on","gcc-runtime","gcc","build").
condition_requirement(1,"node","gcc").
condition_requirement(1,"node_version_satisfies","gcc","=14.2.0").


%----------------------------------------------------------------------------
% Imposed requirements
%----------------------------------------------------------------------------
pkg_fact("gcc-runtime",effect_id(2)).
pkg_fact("gcc-runtime",effect_msg("gcc-runtime@=14.2.0")).
imposed_constraint(2,"node_version_satisfies","gcc-runtime","=14.2.0").


